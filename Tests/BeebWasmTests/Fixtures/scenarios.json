{
  "about": "Scenarios run by both Tests/BeebWasmTests (native Swift) and web/tests (the WebAssembly module), through the same BeebWasm functions; each 'check' must match expected.json on both. ROMs named '@x.rom' are MacBeeb's own (Sources/BeebROMs/ROMs, Acorn's copyright): those scenarios are 'licensed'. The rest use only files here.",
  "scenarios": [
    {
      "name": "synthetic",
      "model": 1,
      "roms": {
        "-1": "parity.rom"
      },
      "steps": [
        {
          "run": 1000000
        },
        {
          "check": "early"
        },
        {
          "run": 3000000
        },
        {
          "check": "later"
        },
        {
          "saveRestore": true
        },
        {
          "check": "restored"
        },
        {
          "run": 2000000
        },
        {
          "check": "afterRestore"
        }
      ]
    },
    {
      "name": "synthetic-chunked",
      "about": "The same as synthetic, run in odd-sized pieces: how a run is divided mustn't matter.",
      "model": 1,
      "roms": {
        "-1": "parity.rom"
      },
      "steps": [
        {
          "runChunks": [
            1000000,
            77777
          ]
        },
        {
          "check": "early",
          "sameAs": "synthetic/early"
        },
        {
          "runChunks": [
            3000000,
            1234567
          ]
        },
        {
          "check": "later",
          "sameAs": "synthetic/later"
        },
        {
          "runChunks": [
            2000000,
            999999
          ]
        },
        {
          "check": "uninterrupted",
          "sameAs": "synthetic/afterRestore",
          "fields": [
            "cycles",
            "pc",
            "a",
            "x",
            "y",
            "s",
            "p",
            "ram"
          ]
        }
      ]
    },
    {
      "name": "synthetic-two-machines",
      "about": "Two machines in one module at once, interleaved, each as if alone.",
      "model": 1,
      "roms": {
        "-1": "parity.rom"
      },
      "steps": [
        {
          "twin": true
        },
        {
          "runChunks": [
            1000000,
            250000
          ]
        },
        {
          "check": "early",
          "sameAs": "synthetic/early"
        }
      ]
    },
    {
      "name": "modelB-basic",
      "licensed": true,
      "model": 1,
      "roms": {
        "-1": "@os12.rom",
        "15": "@basic2.rom",
        "14": "@dfs12.rom"
      },
      "steps": [
        {
          "run": 4000000
        },
        {
          "check": "booted"
        },
        {
          "type": "PRINT 2+2\n"
        },
        {
          "untilTyped": true
        },
        {
          "run": 200000
        },
        {
          "check": "printed"
        },
        {
          "key": [
            65,
            1
          ]
        },
        {
          "run": 100000
        },
        {
          "key": [
            65,
            0
          ]
        },
        {
          "run": 100000
        },
        {
          "key": [
            73,
            1
          ]
        },
        {
          "run": 100000
        },
        {
          "key": [
            73,
            0
          ]
        },
        {
          "run": 300000
        },
        {
          "check": "keyed"
        },
        {
          "reset": 1
        },
        {
          "run": 2000000
        },
        {
          "check": "afterBreak"
        }
      ]
    },
    {
      "name": "modelB-disc",
      "licensed": true,
      "model": 1,
      "roms": {
        "-1": "@os12.rom",
        "15": "@basic2.rom",
        "14": "@dfs12.rom"
      },
      "steps": [
        {
          "run": 4000000
        },
        {
          "insertDisc": [
            0,
            0,
            "parity.ssd"
          ]
        },
        {
          "reset": 3
        },
        {
          "run": 16000000
        },
        {
          "check": "ran"
        },
        {
          "exportDisc": [
            0,
            0
          ]
        },
        {
          "check": "written"
        },
        {
          "saveRestore": true
        },
        {
          "run": 2000000
        },
        {
          "check": "afterRestore"
        },
        {
          "type": "PRINT 6*7\n"
        },
        {
          "untilTyped": true
        },
        {
          "run": 200000
        },
        {
          "check": "continued"
        }
      ]
    },
    {
      "name": "modelB-disc-uninterrupted",
      "about": "modelB-disc without the save and restore: the machine must be the same (the TV, which isn't in a state, restarts).",
      "licensed": true,
      "model": 1,
      "roms": {
        "-1": "@os12.rom",
        "15": "@basic2.rom",
        "14": "@dfs12.rom"
      },
      "steps": [
        {
          "run": 4000000
        },
        {
          "insertDisc": [
            0,
            0,
            "parity.ssd"
          ]
        },
        {
          "reset": 3
        },
        {
          "run": 16000000
        },
        {
          "run": 2000000
        },
        {
          "check": "uninterrupted",
          "sameAs": "modelB-disc/afterRestore",
          "fields": [
            "cycles",
