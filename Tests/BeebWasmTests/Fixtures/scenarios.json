    {
      "name": "modelB-sound-and-joystick",
      "licensed": true,
      "model": 1,
      "roms": {
        "-1": "@os12.rom",
        "15": "@basic2.rom",
        "14": "@dfs12.rom"
      },
      "steps": [
        {
          "audio": 48000
        },
        {
          "run": 4000000
        },
        {
          "joystick": [
            0,
            1.0,
            -0.5,
            1
          ]
        },
        {
          "type": "SOUND 1,-15,100,20:SOUND &10,-10,4,10\nPRINT ADVAL(1);\" \";ADVAL(2);\" \";ADVAL(0) AND 3\n"
        },
        {
          "untilTyped": true
        },
        {
          "run": 2000000
        },
        {
          "check": "played"
        }
      ]
    },
    {
      "name": "econet-two-stations",
      "about": "Two Model Bs with DNFS on one line (as Tests/BeebCoreTests/EconetTests): station 2 opens a receive block, station 1 sends it HELLO ECONET.",
      "licensed": true,
      "network": {
        "clock": 200000
      },
      "machines": [
        {
          "model": 1,
          "roms": {
            "-1": "@os12.rom",
            "15": "@basic2.rom",
            "14": "@dnfs.rom"
          },
          "station": 1
        },
        {
          "model": 1,
          "roms": {
            "-1": "@os12.rom",
            "15": "@basic2.rom",
            "14": "@dnfs.rom"
          },
          "station": 2
        }
      ],
      "steps": [
        {
          "run": 3000000
        },
        {
          "type": "10 DIM B% 80,C% 20\n20 C%?0=0:C%?1=&7F:C%?2=&77:C%?3=0:C%?4=0:C%!5=B%:C%!9=B%+80\n30 X%=C%:Y%=C% DIV 256:A%=&11:CALL &FFF1\n40 N%=C%?0:PRINT \"OPEN \";N%\n50 REPEAT:A%=&33:X%=N%:R%=USR(&FFF4):UNTIL (R% AND &8000)<>0\n60 C%?0=N%:X%=C%:Y%=C% DIV 256:A%=&11:CALL &FFF1\n70 PRINT \"FROM \";C%?3;\" GOT \";$B%\nRUN\n",
          "on": 1
        },
        {
          "untilTyped": true
        },
        {
          "run": 1000000
        },
        {
          "check": "listening",
          "on": 1
        },
        {
          "type": "10 DIM B% 80,C% 20\n20 $B%=\"HELLO ECONET\"\n30 C%?0=&80:C%?1=&77:C%?2=2:C%?3=0:C%!4=B%:C%!8=B%+LEN$B%+1\n40 X%=C%:Y%=C% DIV 256:A%=&10:CALL &FFF1\n50 REPEAT:A%=&32:R%=USR(&FFF4):UNTIL (R% AND &8000)=0\n60 PRINT \"RESULT \";(R% AND &FF00) DIV 256;\" \";C%?0\nRUN\n",
          "on": 0
        },
        {
          "untilTyped": true
        },
        {
          "run": 4000000
        },
        {
          "check": "sent",
          "on": 0
        },
        {
          "check": "received",
          "on": 1
        }
      ]
    },
